#!/bin/sh
# Refuses a commit whose staged changes look like they hold a secret.
# Enabled by `npm install` (the prepare script sets core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes were not scanned for secrets." >&2
  echo "pre-commit: install it (Fedora: sudo dnf install gitleaks; macOS: brew install gitleaks). CI scans every push regardless." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner
